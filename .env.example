# =============================================================================
# RESPALDO DE OFICIOS - Variables de entorno
# Copiar como .env y ajustar valores. Nunca versionar el .env real.
# =============================================================================

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=respaldooficios
DB_USER=oficios_user
DB_PASS=CHANGE_ME

# Aplicación
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8090
# Subcarpeta cuando la app se sirve bajo un Alias (p. ej. /oficios). Vacío = raíz.
APP_BASE_PATH=
# Cadena aleatoria larga (p. ej. `php -r "echo bin2hex(random_bytes(32));"`)
APP_SECRET=CHANGE_ME

# Sesiones
SESSION_LIFETIME=7200
SESSION_NAME=respaldo_oficios_sess

# Uploads (fuera del webroot)
UPLOAD_MAX_SIZE=10485760
UPLOAD_DIR=/var/www/uploads

# Zona horaria
APP_TIMEZONE=America/Mexico_City
