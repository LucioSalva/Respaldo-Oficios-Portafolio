# =============================================================================
# Apache - Respaldo de Oficios servido bajo una subcarpeta (Alias /oficios)
#
# Permite que la app conviva con otras aplicaciones en el mismo Apache sin
# VirtualHost dedicado. El Alias apunta SOLO a public/, de modo que app/,
# sql/, storage/, tools/, etc. nunca quedan expuestos.
#
# Uso:
#   1) Ajustar APP_DIR a la ruta donde vive el proyecto.
#   2) Incluir este archivo desde httpd.conf (Include ...) o sites-enabled.
#   3) Requiere mod_rewrite, mod_alias y mod_headers.
#   4) En public/.htaccess usar "RewriteBase /oficios/" y en .env
#      APP_BASE_PATH=/oficios
# =============================================================================

Define APP_DIR "/var/www/oficios"

Alias /oficios "${APP_DIR}/public"

<Directory "${APP_DIR}/public">
    Options -Indexes +FollowSymLinks
    AllowOverride All
    Require all granted
    DirectoryIndex index.php

    <IfModule mod_headers.c>
        Header always set X-Frame-Options         "SAMEORIGIN"
        Header always set X-Content-Type-Options  "nosniff"
        Header always set Referrer-Policy         "strict-origin-when-cross-origin"
        Header always set Permissions-Policy      "geolocation=(), microphone=(), camera=()"
    </IfModule>
</Directory>

# Defensa en profundidad: denegar por nombre las carpetas internas del repo
# por si otra app o un Alias mal configurado expusiera la raíz.
<DirectoryMatch "^${APP_DIR}/(app|sql|storage|tests|tools|deploy|vendor)">
    Require all denied
</DirectoryMatch>

# Bloquear archivos sensibles en cualquier ubicación del repo.
<FilesMatch "\.(env|sql|log|sh|md|yml|yaml|json|ini|bak|swp|git|rar|zip)$">
    Require all denied
</FilesMatch>
